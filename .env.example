# Copy to .env for a local run; Django reads it at start-up, and variables already set in the environment win.
# Every setting is optional.

# Truck routing and place search. Without a key, the keyless public Valhalla and OSRM servers route the trucks
# and Photon searches places. Keys: https://developer.tomtom.com/
TOMTOM_API_KEY=

# Routing engines in the order they are tried.
ROUTING_PROVIDERS=tomtom,valhalla,osrm

# Most forecast locations one plan may ask Open-Meteo for (checkpoints plus the corridor heatmap).
WEATHER_LOCATION_BUDGET=450

# How far ahead a departure may be, in days.
DEPARTURE_MAX_DAYS_AHEAD=7

# A cache shared by every process (needs `uv sync --extra redis`); otherwise each process keeps its own.
REDIS_URL=

# Open-Meteo: the free API by default. With a commercial key, set it and the customer endpoint
# (https://customer-api.open-meteo.com/v1/forecast).
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=

# Public routing and search servers, for self-hosted ones.
VALHALLA_URL=https://valhalla1.openstreetmap.de
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.vercel.app
LOG_LEVEL=INFO
