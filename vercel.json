{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "config.wsgi:application",
      "functions": {
        "config/wsgi.py": {
          "maxDuration": 120,
          "excludeFiles": "{tests/**,**/__pycache__/**,.venv/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
